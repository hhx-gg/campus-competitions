{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "杜绝信息差",
  "version": "0.6.0",
  "identifier": "com.campuscompetitions.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "杜绝信息差——大学生友好竞赛消息工具",
